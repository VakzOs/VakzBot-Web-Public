# Application ID du bot (Developer Portal -> General Information).
# Obligatoire : sans elle, la connexion Discord du dashboard echoue (OAuth2).
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Secret OAuth2 (Developer Portal -> OAuth2 -> Client Secret). Requis pour le dashboard.
DISCORD_CLIENT_SECRET=

# Chaine aleatoire longue pour signer les sessions JWT (openssl rand -hex 32).
# Minimum 32 caracteres : un secret faible affaiblit l'integrite des sessions.
AUTH_SECRET=

# Optionnel : token du bot, pour afficher sur quels serveurs il est deja present.
DISCORD_BOT_TOKEN=

# Config live du dashboard (API du bot sur le VPS). Vide = dashboard lecture seule.
# ⚠️  Utilise une URL HTTPS (https://...) : ce token administre TOUS les serveurs,
#     il ne doit jamais transiter en clair. Evite un http://IP:PORT en clair.
BOT_API_URL=
# Meme valeur que WEB_API_TOKEN cote bot (openssl rand -hex 32).
BOT_API_TOKEN=
# Debloque les panneaux reserves au proprietaire du bot (mise a jour,
# redemarrage, statuts, logs, taches, catalogue gacha, plafonds).
# Ton identifiant Discord.
BOT_OWNER_ID=

# Avatar du bot pour l'icone du site (favicon + logo). URL publique de l'image
# (clic droit sur l'avatar du bot dans Discord -> Copier le lien de l'image).
# Vide = l'avatar ecrit en dur dans lib/site.ts est utilise.
NEXT_PUBLIC_BOT_AVATAR_URL=

# --- Mise a jour automatique (FORCE_UPDATE) ---
# Ce reglage n'est PAS une variable Vercel : le site est mis a jour par le
# workflow GitHub `.github/workflows/auto-update.yml`, qui realigne chaque nuit
# a 01:10 UTC ta branche principale sur VakzOs/VakzBot-Web-Public, en
# fast-forward uniquement. Vercel redeploie ensuite tout seul.
# Il se pilote depuis GitHub : Settings > Secrets and variables > Actions >
# Variables > FORCE_UPDATE = true (defaut, meme si la variable est absente)
# ou false pour couper la mise a jour automatique.
